interface Store {
  fn get(self, k: Str) -> Str? uses fs.read
}

fn twice[fx: Effects](f: fn() -> () uses fx) -> () uses fx {
  f()
}

enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
  Named(from Inner)
  Empty
}

enum Level: Int {
  Low = 1
  High = 2
}

type Id = Int
type Meters(Float)

fn (s: Shape) area() -> Float {
  match s {
    Circle(r) => 3.14 * r * r
    Rect(w, h) => w * h
    Named(_) | Empty => 0.0
  }
}

fn isqrt(n: Int) -> Int
  requires n >= 0
  ensures result * result <= n
{
  old(n)
  n
}

