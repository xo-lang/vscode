// ==== function with clauses
/// Returns the user with the given id.
pub fn fetch_user(db: Db, id: Int) -> User ! LoadErr
  uses net
  requires id > 0
{
  let row = db.query_one("select 1", id)?
  row
}

// ==== methods
fn (u: User) display_name() -> Str { u.name }

pub fn (var a: Account) deposit(amt: Money) requires amt > 0 {
  a.balance += amt
}

// ==== generic function
fn first[T](xs: List[T]) -> T? {
  xs.get(0)
}

// ==== struct with derive and invariant
struct Account {
  pub id: Int
  balance: Int = 0
  kind as "type": Str
}
invariant balance >= 0
derive Json, Eq

// ==== enum
enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
  Empty
} derive Eq

enum Level: Str {
  Debug = "debug"
  Info = "info"
}

// ==== interface
interface Shape {
  fn area(self) -> Float
  fn name(self) -> Str
}

// ==== type aliases and newtypes
type Id = Int
type Meters struct(Float) derive Eq

// ==== constants
const MAX_USERS = 1000
pub const DEFAULT = Config{port: 8080}
const PAGE: Str = embed("static/index.html")

// ==== use declarations
use std/http
use github.com/acme/billing as bill
use go "net/url" as neturl
use c "zlib.h" link "z" as zlib uses none

// ==== effects
pub fn sync(net: Net) -> Bool uses net.dial {
  true
}

fn run(f: fn() -> Int uses clock) -> Int uses (clock, net) { f() }

// ==== scope and select
fn f() {
  scope s {
    s.spawn(fn() { work() })
  }
  select {
    v = ch => handle(v)
    after 1s => timeout()
  }
}

// ==== scope as a name
fn f(scope: Str) -> Str {
  let a = scope
  "scope=${scope}"
}

// ==== comments and doc comments
// line comment
/// doc comment, attaches to the next declaration
pub fn f() {}

// ==== number literals
fn f() {
  let a = 42
  let b = 1_000_000
  let c = 0xff
  let d = 0b1010
  let e = 0o755
  let f = 3.14
  let g = 1e-9
  let h = 250ms
  let i = 5s
}

// ==== runes and bools
fn f() {
  let a = 'a'
  let b = '\n'
  let c = '\u{1F600}'
  let d = true
  let e = false
}

// ==== strings and interpolation
fn f() {
  let a = "hello ${name}, you have ${count + 1} items"
  let b = "GET /users/{id}"
  let c = "price: \$5"
  let d = "${xs:?} and ${a + b:?}"
  let e = "cost $5"
}

// ==== raw strings
fn f() {
  let a = r"raw: no escapes \d+"
  let b = r#"raw, may contain "quotes": {"a": 1}"#
  let c = r"""
    multi line raw
  """
}

// ==== multi line and bytes strings
fn f() {
  let a = """
    multi line ${x}
    with "quotes" inside
  """
  let b = b"raw bytes\x00"
}

// ==== collections
fn f() {
  let a = [1, 2, 3]
  let b = []
  let c = {"a": 1, "b": 2}
  let d = {}
  let e = #{1, 2, 3}
  let f = #{}
}

// ==== bindings
fn f() {
  let x = 10
  var total = 0
  total += x
  let (q, r) = (7 / 2, 7 % 2)
  var (lo, hi) = (0, 10)
  const LIMIT = 5
}

// ==== closures
fn f() {
  let double = fn(x: Int) -> Int { x * 2 }
  xs.map(fn(x) { x * 2 })
  let load = fn(id: Int) -> User ! LoadErr uses net { store.get(id)? }
}

// ==== method chains over lines
fn f() {
  http.json(429, {"error": "rate limited"})
    .with_header("Retry-After", "${secs}")
}

// ==== control flow
fn f() {
  if cond { a() } else if other { b() } else { c() }
  for x in xs { use_it(x) }
  for (i, x) in xs.indexed() { show(i, x) }
  while n > 0 { n -= 1 }
  outer: for a in as { break outer }
  while { work() }
  if let Some(v) = opt { v } else { 0 }
}

// ==== match and patterns
fn f(s: Shape) -> Float {
  match s {
    Circle(r) => 3.14 * r * r
    Rect(w, h) if w > 0 => w * h
    Shape.Empty => 0.0
    _ => 1.0
  }
}

// ==== result and option operators
fn f() -> Int ! Err {
  let a = g()?
  let b = h() ?? return 0
  let c = k() ?? e => fault("${e}")
  a + b + c
}

// ==== slicing and indexing
fn f(xs: List[Int]) {
  let a = xs[0]
  let b = xs[1..3]
  let c = xs[..2]
  let d = xs[2..]
  let e = json.decode[User](bytes)
  let g = Mutex[Int].new(0)
}

// ==== struct literals and update
fn f() {
  let p = Point{x: 1, y: 2}
  let q = p with {x: 5}
  if (p == Point{x: 0, y: 0}) { reset() }
  let Point{x, y} = p
}

// ==== defer and return
fn f() -> Int {
  defer { cleanup() }
  defer close(h)
  return 1
}

// ==== tests
test "adds" {
  expect(1 + 1) == 2
}

test "with seed" seed 7 uses (clock) {
  expect(true)
}

// ==== contracts
pub fn div(a: Int, b: Int) -> Int
  requires b != 0 else fault("zero")
  ensures result * b <= a
{
  a / b
}
